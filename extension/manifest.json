{
  "manifest_version": 3,
  "name": "LLM Translate PoC",
  "version": "0.0.1",
  "description": "PoC: translate page paragraphs with a local LLM CLI via Native Messaging.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
